# OpenOps 后端启动脚本（内网 Windows）。
#
# 用法：复制本文件为 run-backend.ps1，填入下面的 PG 连接信息，然后在 backend/ 目录执行：  .\run-backend.ps1
# ⚠ run-backend.ps1 含明文密码，已在 .gitignore——切勿提交 git。
#
# 首次准备（各做一次）：
#   1) 建虚拟环境 + 装依赖：
#        python -m venv .venv
#        .\.venv\Scripts\Activate.ps1
#        pip install -e ".[test]"            # 默认 mock/fake，不装 agentscope/redis
#   2) 建表：在 PG 工作台/psql 里连到你的库，把 search_path 设到你的 schema 后跑一次 DDL
#        （表名带 sre_ 前缀，会落到该 schema，须与下面 OPENOPS_PG_SCHEMA 一致）：
#        SET search_path TO <你的schema>;   然后执行 sql\openops_v1_core.sql 全文

Set-Location $PSScriptRoot   # 切到 backend/（脚本所在目录）

# ==================== 必填：PG 连接（离散变量，密码/特殊字符免转义） ====================
$env:OPENOPS_PG_HOST     = "<主机，如 7.198.147.89>"
$env:OPENOPS_PG_PORT     = "5432"
$env:OPENOPS_PG_DB       = "<库名，如 wesee>"
$env:OPENOPS_PG_USER     = "<用户，如 observe_analysis>"
$env:OPENOPS_PG_PASSWORD = "<密码>"                          # keyword 格式，@ : / # 等无需转义
$env:OPENOPS_PG_SCHEMA   = "<schema，如 observe_analysis>"   # 表落此 schema（search_path）；留空=账号默认
# $env:OPENOPS_PG_SSLMODE = "require"                        # 公司库要 SSL 时取消注释
#
# （或用整串回退：$env:OPENOPS_DATABASE_URL="postgresql://..."。设了 OPENOPS_PG_HOST 就走离散变量、忽略整串。）

# ==================== 可选 ====================
# $env:OPENOPS_ENCRYPTION_KEY = "<生产 Fernet key>"   # 调试可不配（走 dev 派生 key，仅告警）
# 其余全默认走 mock/fake，无需设。切真开关见 backend\docs\EXTERNAL-INTEGRATION.md

Write-Host "启动后端（端口 18082）… 打开 http://localhost:18082/health 应返回 {status: ok}" -ForegroundColor Cyan
& .\.venv\Scripts\python.exe -m uvicorn main:app --app-dir src --port 18082
