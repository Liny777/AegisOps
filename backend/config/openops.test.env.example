# ============================================================
# OpenOps 后端环境配置（测试环境）
# 复制为 openops.test.env 并填值；含凭证，绝不入 git（已 gitignore）。
# 完整变量说明见 backend/docs/EXTERNAL-INTEGRATION.md。
# ============================================================

# ---- ① 数据库（必配；test/prod 各自独立库！pytest 会 TRUNCATE，严禁指向生产库）----
OPENOPS_PG_HOST=<PG主机>
OPENOPS_PG_PORT=5432
OPENOPS_PG_DB=openops_test
OPENOPS_PG_USER=<用户>
OPENOPS_PG_PASSWORD=<密码>
OPENOPS_PG_SCHEMA=<schema>          # 共享库时用 schema 隔离（表已带 sre_ 前缀）
# OPENOPS_PG_SSLMODE=require

# ---- ② 运行时与模型（必配）----
OPENOPS_RUNTIME=agentscope
OPENOPS_PORT=18082
# 2026-08-17：平台模型 Key 已迁 PG 密文列（管理台「模型资产」弹窗直填）。本变量只在**迁移窗口**
# 保留——后端首次启动会把它加密导入 sre_model_asset，导入确认后即从本文件删除，运行时不再读它。
OPENOPS_PLATFORM_GLM_API_KEY=<平台GLM网关Key>      # 迁移导入源；导入后删除本行
# Agent Studio（管理员回溯复盘，默认开）：捕获 agent/llm/tool span **原文**落
# sre_agent_studio_span（先执行 migrate-2026-07-23-agent-studio-span.sql），仅 /admin/studio/* 可读。
# OPENOPS_AGENT_STUDIO_ENABLED=true
# OPENOPS_STUDIO_TEXT_CAP=8000          # 单字段截断上限（字符）
# OPENOPS_STUDIO_RETENTION_DAYS=30      # span 保留天数（到期硬删）
# 文根自剥前缀（RootPathShim，幂等：带前缀就剥、不带就原样放行 ⇒ 新旧文根可同时服务）。
# 单文根收敛（xxxx.com/openops 一条网关规则）分阶段切换，本行按阶段取值：
#   阶段 1-3（网关仍挂 /openback，或前端镜像可能回滚到旧 /openback/api 烘焙）：保持 /openback
#   阶段 4（网关已删 /openback、新镜像泡稳后）：留空——此时后端只经前端 nginx 收到裸 /api/*
# ⚠留空的时机错了 = 全量 404：真正剥 /openback 的一直是本 shim 而不是网关（给运维的规则
#   proxy_pass 无尾斜杠 ⇒ 不 strip），所以网关还挂着 /openback 时一留空，shim 就不装
#   （main.py 仅在非空时 add_middleware），路由（前缀 /api/openops/v1）全部 miss。
OPENOPS_ROOT_PATH=/openback
OPENOPS_ENCRYPTION_KEY=<Fernet密钥>                # 必配且必须备份：丢失=全部用户 Secret 报废
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- ③ 内网外部系统（35 号内网通关口径；BASE_URL/COOKIE 按环境填）----
OPENOPS_OMODEL=real
OPENOPS_OMODEL_BASE_URL=https://REPLACE_WITH_CONSOLE_HOST/omodel  # 必须是固定域；携带用户 Cookie，禁止 {host}
# OPENOPS_OMODEL_COOKIE=             # ⚠仅本地调试缝——生产勿配（IAM 透传用户登录态）
OPENOPS_OMODEL_TENANT_ID=REPLACE_WITH_CURRENT_ENTERPRISE_TENANT_ID  # 须与 AppTree 当前企业一致
# OPENOPS_OMODEL_PAGE_URL=            # 设置页 iframe 页面前缀覆盖（默认由 BASE_URL 域根派生 /wesee/omodel/index.html?dataSource=api&workspace=）
OPENOPS_MCPREGISTRY=real
OPENOPS_MCPREGISTRY_BASE_URL=<console 根>       # 同样支持 {host} 占位符
# OPENOPS_MCPREGISTRY_COOKIE=        # ⚠仅本地调试缝——生产勿配（IAM 透传用户登录态）
OPENOPS_MCP=real
OPENOPS_MCP_ROUTE=direct             # console proxy 有问题时 direct 直连 server_url
# --- 平台 MCP 出站头 x-ec2-ip（本机主机 IP，仅平台 MCP 的 tools/call + tools/list 带；用户自注册 MCP 一律不带）---
# ⚠对端按该 IP 做**白名单准入**（只授权特定主机调其 MCP），故此值必须与对端登记项逐字节一致。
#   **必配**：不配即不带该头，平台 MCP 调用会被对端判为未授权。启动日志会打印当前取值/缺失告警。
OPENOPS_EC2_IP=<本机对外 IP，需先向 MCP 对端登记授权>
OPENOPS_SKILLHUB=real
# OPENOPS_SKILLHUB_BASE_URL=         # 缺省回退 MCPREGISTRY_BASE_URL
# OPENOPS_SKILLHUB_COOKIE=           # 发布验收勿配，使用 IAM 用户登录态
OPENOPS_APPTREE=real
OPENOPS_APPTREE_BASE_URL=<AppTree 根>
OPENOPS_APPTREE_ENTERPRISE_ID=REPLACE_WITH_CURRENT_ENTERPRISE_TENANT_ID
# OPENOPS_APPTREE_COOKIE=            # 发布验收勿配，使用 IAM 用户登录态
# OPENOPS_CONSOLE_COOKIE=            # ⚠仅本地调试缝（四面共享）——生产勿配，IAM 透传用户登录态

# ---- ④ 出站硬化（内网 TLS 三档：CA 文件 ＞ 临时 INSECURE ＞ certifi/truststore）----
OPENOPS_HTTP_TRUST_ENV=0             # SWG 代理会劫内网直连，默认关
OPENOPS_HTTP_DEBUG=0                 # 联调临时可开；验收后须关闭，日志仅输出脱敏元数据
# OPENOPS_HTTP_DEBUG_SAMPLE_S=60     # 开 HTTP_DEBUG 时，同状态码的出站调试行抑制窗口（0=不抑制）
# OPENOPS_TLS_CA_FILE=/opt/openops/certs/corp-ca.pem
# OPENOPS_TLS_INSECURE=1             # 仅联调临时
# OPENOPS_APPTREE_USER_ID=           # 仅本地联调；发布门禁拒绝
# OPENOPS_SCOPE_OVERRIDE_APPIDS=     # 仅本地联调；发布门禁拒绝

# ---- ⑤ IAM（测试发布验收须启用；本地 pytest 由测试夹具独立控制）----
OPENOPS_IAM_ENABLED=true
OPENOPS_IAM_ACCESS_TOKEN_URL=REPLACE_WITH_IAM_ACCESS_TOKEN_URL
OPENOPS_IAM_USERINFO_URL=REPLACE_WITH_IAM_USERINFO_URL
# OPENOPS_IAM_LOGIN_KEY_FIELD=id     # 支持点分嵌套如 data.user.id
# OPENOPS_IAM_DISPLAY_NAME_FIELD=name
# —— 仅浏览器 LOGIN/SIGNOUT 回跳可用 {host}；上方 token/userinfo 必须是固定 HTTPS 地址 ——
# OPENOPS_IAM_LOGIN_URL=https://{host}/epstenant/#/login?redirect=https%3A%2F%2F{host}%2Fopenops%2F%3F
# —— SIGNOUT 是「只收 POST + CSRF 头」的 SSO 登出 API，前端**后台 POST**（非浏览器 GET，否则 404 白页）——
# OPENOPS_IAM_SIGNOUT_URL=https://{host}/gw/iam/auth/logout
# OPENOPS_IAM_SIGNOUT_URL=
# CSRF cookie/header 名（前端从 cookie 取 token 放进 signout POST 头；默认 IAM-Csrf-Token）
# OPENOPS_IAM_CSRF_COOKIE_NAME=IAM-Csrf-Token
# OPENOPS_IAM_CSRF_HEADER_NAME=IAM-Csrf-Token
# 登出清 SSO 后浏览器回跳地址（支持 {host}；未配则回落 login_url）。设 /openops/ 而非 / 避免进 console 登录流
# OPENOPS_IAM_LOGOUT_REDIRECT_URL=/openops/

# ---- ⑥ 沙箱（Linux 机可切 docker；先 fake 验证主链，再切 docker 跑 Skill/Bash 实体）----
OPENOPS_SANDBOX=fake
# OPENOPS_SANDBOX=docker             # 需 pip install -e ".[sandbox]" + docker.sock 权限 + 基础镜像已 load

# ---- ⑦ 治理与安全旋钮（默认值即老项目经验口径，一般不动）----
# OPENOPS_MAIN_MAX_ITERS=20
# OPENOPS_MAIN_TOOL_RESULT_LIMIT=24000     # 不变式：< 模型窗口 ≤1/3
# OPENOPS_SUBAGENT_TIMEOUT_S=300
# OPENOPS_ASK_TIMEOUT_S=300
# OPENOPS_MCP_RESULT_CAP=24000
# OPENOPS_LLM_EGRESS_BLOCK_PRIVATE=0       # 纯内网放行 RFC1918；对外部署置 1
# OPENOPS_LLM_EGRESS_PIN=1

# ---- ⑧ 日志（容量上限在主机侧：journald.conf.d + docker json-file，见 docs/deploy-intranet.md 三½）----
# OPENOPS_LOG_LEVEL=INFO                   # 日志量偏大时先调 WARNING（会连 uvicorn access 行一起静掉）
# OPENOPS_ACCESS_LOG_DEDUP_S=60            # 同 (路径,状态码) 的 access 行抑制窗口；0=关（排查具体请求时用）
# OPENOPS_THIRD_PARTY_LOG_LEVEL=WARNING    # httpx/aiokafka/urllib3 等第三方库级别；调 INFO 会按每次出站刷屏且带完整 URL
# OPENOPS_IAM_TOKEN_TTL_S=300              # 服务态 IAM token 进程内缓存；0=每次出站现取（内网 j2c 无缓存，勿设 0）
# OPENOPS_SCOPE_PEEK_TTL_S=30              # 告警摄入 peek 范围的缓存；默认同 OPENOPS_SCOPE_TTL_S
# OPENOPS_SCOPE_PEEK_FAIL_TTL_S=10         # peek 失败的负缓存——oModel 持续不可用时防每批重打
