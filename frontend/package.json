{
  "name": "openops-v1-frontend-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "runtime": "tsx watch server/copilot-runtime.ts",
    "runtime:start": "node --import tsx server/copilot-runtime.ts",
    "test:activity": "node --import tsx --test src/lib/activity/model.test.ts",
    "test:workbench-lifecycle": "node --import tsx --test src/layout/workbenchSession.test.ts src/lib/runtime/sse.test.ts",
    "test:request-convergence": "node --import tsx --test src/lib/api/singleFlight.test.ts src/lib/api/requestConvergence.test.ts src/lib/runtime/sse.test.ts",
    "test:rich-ui": "node --import tsx --test src/workbench/copilot/rich-ui/*.test.ts",
    "test:chat-ui": "node --import tsx --test src/workbench/copilot/toolGrouping.test.ts",
    "test:runtime-lifecycle": "node --import tsx --test server/*.test.ts",
    "e2e": "playwright test",
    "e2e:real": "OPENOPS_E2E_REAL=1 playwright test e2e/real-workbench-persistence.spec.ts e2e/history-switch-storm.spec.ts",
    "e2e:real:stub-stream": "OPENOPS_E2E_REAL=1 OPENOPS_E2E_STUB_STREAM=1 playwright test e2e/real-workbench-persistence.spec.ts --grep 'Stub 真实链路'",
    "e2e:history-load": "OPENOPS_E2E_REAL=1 OPENOPS_E2E_LOAD=1 playwright test e2e/history-switch-storm.spec.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/a2ui-renderer": "1.61.2",
    "@copilotkit/react-core": "1.61.2",
    "@copilotkit/runtime": "1.61.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-webfont": "^3.44.0",
    "express": "4.22.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1",
    "rxjs": "7.8.1",
    "tsx": "4.23.0",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "4.17.25",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
