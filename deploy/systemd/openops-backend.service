# 后端机 systemd 单元。安装：
#   sudo cp openops-backend.service /etc/systemd/system/
#   发布包解压到 /opt/openops/releases/<BUILD_ID>，/opt/openops/current 原子指向当前版本。
#   按环境改 EnvironmentFile 指向 openops.test.env 或 openops.prod.env。
#   sudo systemctl daemon-reload && sudo systemctl enable --now openops-backend
[Unit]
Description=OpenOps V1 Backend (uvicorn via run.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openops/current/backend
EnvironmentFile=/opt/openops/shared/config/openops.prod.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/openops/current/.venv/bin/python run.py
Restart=always
RestartSec=5
User=openops
# 沙箱切 docker（OPENOPS_SANDBOX=docker）须让运行用户能读写 /var/run/docker.sock。取消下一行注释即可
# （声明式、随单元走）；注意宿主须已有 docker 组，否则 systemd 会因 SupplementaryGroups 不存在拒绝启动。
# SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
